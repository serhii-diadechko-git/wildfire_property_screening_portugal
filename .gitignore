# Python
__pycache__/
*.py[cod]
.venv/
.ipynb_checkpoints/

# VS Code local state
.vscode/*.local.json

# Local assistants, credentials, and machine-specific configuration
.codex/
.agents/
.env
.env.*
!.env.example
local_data_paths.json

# Data: keep folder structure, not downloaded or generated data
/data/raw/*
!/data/raw/.gitkeep
/data/external/*
!/data/external/.gitkeep
/data/interim/*
!/data/interim/.gitkeep
/data/processed/*
!/data/processed/.gitkeep

# Generated reports
/reports/figures/*
!/reports/figures/.gitkeep
!/reports/figures/README.md
/reports/tables/*
!/reports/tables/.gitkeep
!/reports/tables/README.md
/reports/validation/*.txt
/reports/run_logs/*
!/reports/run_logs/.gitkeep

# Transient processing output; final artefacts use atomic publication paths.
/tmp/
*.tmp
*.tmp.*

# OS files
.DS_Store
Thumbs.db

# Microsoft Office temporary lock files
~$*.pptx
~$*.docx
~$*.xlsx
